#!/usr/bin/env python3

'''

Fix barcodes for a BAM file for some metric;

'''

import sys, os, argparse, logging, time
import pysam
import itertools

#script_path = os.path.dirname(os.path.realpath(__file__))
#sys.path.append(os.path.join(script_path, '../'))
#import te_count

# Command-line options;
def prepare_parser():
    exmp = 'Example usage: fix_barcodes -i in.bam -o out.bam -w whitelist'

    description = ('Fix barcodes in a BAM file using the provided whitelist. Add a CB code; Assumes the BAM'
                   'file has been output from something like STARsolo with one read per line and a CR tag;')

    parser = argparse.ArgumentParser(prog='te_count', description=description, epilog=exmp)

    # Optional:
    optional = parser._action_groups.pop()

    required = parser.add_argument_group('required arguments')

    required.add_argument('-i', '--inbam', nargs=1, required=True, help='the BAM alignment file containing the reads')
    required.add_argument('-o', '--outbam', nargs=1, required=True, help='the BAM file to save the genes and count data to')
    required.add_argument('-w', '--whitelist', nargs=1, required=True, help='A whitelist of barcodes')

    parser._action_groups.append(optional)

    logging.basicConfig(level=logging.DEBUG,
                    format='%(levelname)-8s: %(message)s',
                    datefmt='%m-%d %H:%M')

    parser.log = logging.getLogger('fix_barcodes')

    return parser


def one_bp_mismatch(motif):
    return list(set(itertools.chain.from_iterable(
        [["".join([motif[:pos], nucleotide, motif[pos+1:]]) for nucleotide in {"A", "C", "G", "T"}] for pos in range(len(motif))])))

def one_bp_mismatchB(motif):
    return list(set(itertools.chain.from_iterable(
        [[motif[:pos] + nucleotide + motif[pos+1:] for nucleotide in {"A", "C", "G", "T"}] for pos in range(len(motif))])))

def main():
    assert sys.version_info >= (3, 8), 'Python >=3.8 is required'

    s = time.time()

    script_path = os.path.dirname(os.path.realpath(__file__))
    parser = prepare_parser()
    args = parser.parse_args()

    log = parser.log

    log.info('Arguments:')
    log.info('  inbam: %s' % args.inbam[0])
    log.info('  outbam: %s' % args.outbam[0])
    log.info('  whitelist: {0}'.format(args.whitelist[0]))

    with open(args.whitelist[0], 'rt') as w:
        whitelist = {l.strip() for l in w}

    log.info(f'Found {len(whitelist):,} barcodes')

    barcodes_searched_memo = {}

    _twoN_rejected = 0
    _rescued_oneN_read = 0
    _failed_to_rescue_oneN_read = 0
    _read_written = 0
    _rescued_one_bp_mismatch = 0
    _umi_mismatch_fixed = 0

    lastCB = None
    lastUMI = None

    with pysam.AlignmentFile(args.inbam[0], 'r') as inBAM:
        with pysam.AlignmentFile(args.outbam[0], 'wb', template=inBAM) as outBAM:
            for idx, read in enumerate(inBAM.fetch(until_eof=True)):
                if idx % 1e6 == 0:
                    log.info('Processed {:,} reads'.format(idx))

                if 'CB' in tags:
                    barcode = tags['CB']
                CR = read.get_tag('CR')
                CB = None
                UR = read.get_tag('UR') # We have to get, even if we don't need it;
                UB = None

                # Simple rejections, e.g. two N
                if 'N' in CR:
                    if CR.count('N') >= 2:
                        _twoN_rejected += 1
                        continue
                    # rescue one N read:
                    for atcg in ('A', 'C', 'T', 'G'):
                        searchCR = CR.replace('N', atcg)
                        if searchCR in whitelist:
                            CB = searchCR
                            _rescued_oneN_read += 1
                            break
                    else:
                        _failed_to_rescue_oneN_read += 1

                elif CR in whitelist:
                    CB = CR

                else: # check for 1 bp mismatch
                    if CR in barcodes_searched_memo:
                        CB = barcodes_searched_memo[CR] # Already seen, use the memoised one;

                    else:
                        for m in one_bp_mismatch(CR):
                            if m in whitelist:
                                CB = m
                                _rescued_one_bp_mismatch += 1
                                barcodes_searched_memo[CR] = CB # memo it;
                                break

                if CB:
                    # Only correct UMI if we already fixed the CB
                    # correct UMI, most mismatches can be corrected if the previous UMI Is the same as this one;
                    # Requires a coord sorted BAM
                    # Could cause an error if the first seen UMI is the real one?
                    # In the later case it would just change all UMIs to the erroneous one, and the efect would be the same;
                    if lastCB == CB:
                        # Only do if we are on the same barcode;
                        if lastUMI:
                            if UR == lastUMI:
                                UB = UR
                            else:
                                # on bp mismatch;
                                #print(one_bp_mismatch(UR))
                                for m in one_bp_mismatch(UR):
                                    if m == lastUMI:
                                        UB = m
                                        _umi_mismatch_fixed += 1
                                        break
                        else:
                            UB = UR
                    else:
                        UB = UR

                    # All valid
                    read.set_tag('CB', CB)
                    read.set_tag('UB', UB)
                    outBAM.write(read)
                    _read_written += 1
                    lastCB = CB
                    lastUMI = UB

    log.info('Stats:')
    log.info(f'  Total processed reads              : {idx:,}')
    log.info(f'  Two N rejected reads               : {_twoN_rejected:,}')
    log.info(f'  Rescued one N read                 : {_rescued_oneN_read:,}')
    log.info(f'  Failed to rescue one N read        : {_failed_to_rescue_oneN_read:,}')
    log.info(f'  Rescued barcode with 1 bp mismatch : {_rescued_one_bp_mismatch:,}')
    log.info(f'  Reads not rescued                  : {idx-_read_written:,}')
    log.info(f'  -----------------------------------')
    log.info(f'  UMIs fixed by matching previous UMI: {_umi_mismatch_fixed:,}')
    log.info(f'  -----------------------------------')
    log.info(f'  Reads written                      : {_read_written:,}')

    e = time.time()
    log.info(f'Took {e-s:.2f}s')

    return

if __name__ == '__main__':
    try:
        main()
    except KeyboardInterrupt:
        sys.stderr.write("User interrupt\n")
        sys.exit(0)
